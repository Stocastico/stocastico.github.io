{
  "name": "stocastico-github-io",
  "version": "1.0.0",
  "description": "Personal website of Stefano Masneri — AI Engineer",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/main.node.test.js test/europe-map.test.js test/locations-generator.test.js test/new-project.test.js test/cv.test.js test/generate-cv.test.js",
    "test:main": "node --test test/main.node.test.js",
    "test:locations": "node --test test/locations-generator.test.js",
    "test:project": "node --test test/new-project.test.js",
    "test:cv": "node --test test/cv.test.js",
    "test:generate-cv": "node --test test/generate-cv.test.js",
    "new-project": "node scripts/new-project.js",
    "generate-cv": "node scripts/generate-cv.js",
    "generate-locations": "node scripts/generate-locations.js",
    "update-locations:ps": "powershell -ExecutionPolicy Bypass -File scripts/update-locations.ps1",
    "minify": "npx terser js/main.js -o js/main.min.js --compress --mangle"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.58.2",
    "vite": "^8.0.10"
  }
}
